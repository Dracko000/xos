#!/bin/sh
# X session entry point. The app runs in the foreground: if it exits, X exits,
# and systemd restarts xos-kiosk.service.
xset s off
xset s noblank
xset -dpms
xsetroot -solid '#080a0d' 2>/dev/null || true
xrandr --auto >/dev/null 2>&1 || true

if command -v unclutter >/dev/null 2>&1; then
    unclutter -idle 2 -root >/dev/null 2>&1 &
fi

mkdir -p "$HOME/.cache"
openbox --sm-disable >>"$HOME/.cache/openbox.log" 2>&1 &
sleep 0.3

exec /usr/local/bin/xos-shell
